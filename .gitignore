# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/PRODUCTION BACKUPS

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# data written at runtime; do not commit listener sessions or caches
src/data/messages.json
public/data/sessions/sess_*
public/data/analytics.json
public/data/recent_tracks_cache.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# portable PHP used only by npm run dev
/tools
